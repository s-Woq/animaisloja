---
import '../styles/global.css';
import logo from '../styles/icon.ico';
import CookieBanner from '../components/CookieBanner.astro';
const { title = 'Paw & Co.' } = Astro.props; 
const { img = '' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A modern fashion landing page built with Astro" />
    
    <link rel="icon" type="image/x-icon" href={logo} />
    
    <link rel="apple-touch-icon" href="/logoanimais.png" />
    <title>{title}</title>
   
  </head>
  <body>
    
    <slot />
    <CookieBanner />
  </body>
</html>
