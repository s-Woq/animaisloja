---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<form method="post" action="/api/auth/signin">
  <button
    type="submit"
    class={`w-full rounded-full bg-[#f97316] px-4 py-3 font-medium text-black transition hover:bg-[#fb923c] ${className}`.trim()}
  >
    Sign in with Google
  </button>
</form>
