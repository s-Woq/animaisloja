---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<form method="post" action="/api/auth/signin">
  <button
    type="submit"
    class={`w-full rounded-full bg-slate-900 px-4 py-3 font-medium text-white transition hover:bg-amber-600 ${className}`.trim()}
  >
    Sign in with Google
  </button>
</form>
