---
import type { Product } from '../types/product';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const eurFormatter = new Intl.NumberFormat('pt-PT', { style: 'currency', currency: 'EUR' });
---

<script>
  import { addToCart } from '../lib/cart';

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest('[data-add-to-cart]');

    if (button) {
      event.preventDefault();

      const productSlug = button.getAttribute('data-product-slug');
      if (!productSlug) return;

      addToCart(productSlug);
      button.classList.add('cart-bounce');
      button.textContent = 'Added';
      button.setAttribute('aria-label', 'Added to cart');

      window.setTimeout(() => {
        button.classList.remove('cart-bounce');
        button.textContent = 'Add to cart';
        button.setAttribute('aria-label', 'Add to cart');
      }, 900);

      return;
    }

    const card = target?.closest<HTMLElement>('[data-product-card][data-product-url]');
    if (!card) return;

    if (target?.closest('a, button, input, textarea, select, label')) {
      return;
    }

    const productUrl = card.getAttribute('data-product-url');
    if (!productUrl) return;

    window.location.href = productUrl;
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' && event.key !== ' ') return;

    const card = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-product-card][data-product-url]');
    if (!card) return;

    if ((event.target as HTMLElement | null)?.closest('a, button, input, textarea, select, label')) {
      return;
    }

    event.preventDefault();
    const productUrl = card.getAttribute('data-product-url');
    if (!productUrl) return;

    window.location.href = productUrl;
  });
</script>

<article
  class="group cursor-pointer overflow-hidden rounded-3xl border border-orange-500/15 bg-[#0d0d0d] shadow-[0_16px_50px_rgba(0,0,0,0.35)] transition-all duration-300 hover:-translate-y-1 hover:border-[#fb923c]/50 hover:shadow-[0_24px_70px_rgba(249,115,22,0.12)]"
  data-product-card
  data-category={product.category}
  data-product-url={`/shop/${product.slug}`}
  role="link"
  tabindex="0"
>
  <div class="relative">
    <img src={product.image} alt={product.name} class="h-56 w-full object-cover" />
    {product.badge && (
      <span class="absolute left-4 top-4 rounded-full bg-[#f97316] px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-black">{product.badge}</span>
    )}
  </div>
  <div class="space-y-3 p-5">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-[#b79f8d]">{product.category}</p>
      <span class="text-sm text-[#b79f8d]">★ {product.rating}</span>
    </div>
    <h3 class="text-lg font-semibold text-[#fff4e8]">{product.name}</h3>
    <p class="text-sm leading-6 text-[#d7c5b7]">{product.description}</p>
    <div class="flex items-center justify-between gap-3">
      <div>
        <p class="text-lg font-semibold text-[#fff4e8]">{eurFormatter.format(product.price)}</p>
        {product.oldPrice && <p class="text-sm text-[#8b7a6a] line-through">{eurFormatter.format(product.oldPrice)}</p>}
      </div>
      <div class="flex items-center gap-2">
        <button
          data-add-to-cart
          data-product-slug={product.slug}
          class="cursor-pointer rounded-full border border-orange-500/15 bg-orange-500/8 px-3 py-2 text-sm font-medium text-[#fff4e8] transition duration-200 hover:-translate-y-0.5 hover:border-[#fb923c] hover:text-[#fb923c] active:scale-95"
        >
          Add to cart
        </button>
        <a href={`/shop/${product.slug}`} class="rounded-full bg-[#f97316] px-4 py-2 text-sm font-medium text-black transition hover:bg-[#fb923c]">View</a>
      </div>
    </div>
  </div>
</article>

<style>
  .cart-bounce {
    animation: cart-bounce 0.6s ease;
  }

  @keyframes cart-bounce {
    0% { transform: scale(1); }
    40% { transform: scale(0.95); }
    70% { transform: scale(1.04); }
    100% { transform: scale(1); }
  }
</style>
