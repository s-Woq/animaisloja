<aside id="cookie-banner" class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-orange-500/15 bg-black/95 backdrop-blur-xl" aria-live="polite" aria-label="Cookie preferences">
  <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-4 sm:px-6 lg:flex-row lg:items-end lg:justify-between lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-base font-semibold text-[#fff4e8]">Cookies and Data Use</h2>
      <p class="mt-2 text-sm leading-6 text-[#d7c5b7]">We store essential cart and cookie-preference data in your browser, and send checkout details to Stripe only when you start payment. We may also keep technical request logs for security.</p>
      <a href="/cookie-policy" class="mt-2 inline-block text-sm font-semibold text-[#fb923c] transition hover:text-[#f97316]">Read Cookie Policy</a>
    </div>
    <div class="flex gap-3">
      <button id="cookie-reject" type="button" class="rounded-full border border-orange-500/20 px-5 py-2 text-sm font-medium text-[#fff4e8] transition hover:border-[#fb923c] hover:text-[#fb923c]">Reject optional</button>
      <button id="cookie-accept" type="button" class="rounded-full bg-[#f97316] px-5 py-2 text-sm font-medium text-black transition hover:bg-[#fb923c]">Accept</button>
    </div>
  </div>
</aside>

<script>
  const CONSENT_KEY = 'paw-cookie-consent-v1';

  const initCookieBanner = () => {
    const banner = document.getElementById('cookie-banner');
    const acceptButton = document.getElementById('cookie-accept');
    const rejectButton = document.getElementById('cookie-reject');

    if (!banner || !acceptButton || !rejectButton) return;

    const existingChoice = localStorage.getItem(CONSENT_KEY);
    if (existingChoice === 'accepted' || existingChoice === 'rejected') return;

    banner.classList.remove('hidden');

    const saveChoice = (value: 'accepted' | 'rejected') => {
      localStorage.setItem(CONSENT_KEY, value);
      banner.classList.add('hidden');
      window.dispatchEvent(new CustomEvent('cookie:consent-updated', { detail: { value } }));
    };

    acceptButton.addEventListener('click', () => saveChoice('accepted'));
    rejectButton.addEventListener('click', () => saveChoice('rejected'));
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCookieBanner, { once: true });
  } else {
    initCookieBanner();
  }
</script>
