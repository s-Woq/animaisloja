---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SignInWithGoogleButton from '../components/SignInWithGoogleButton.astro';
import { getSupabaseServerClient } from '../lib/supabase';

export const prerender = false;

const supabase = getSupabaseServerClient(Astro);
const {
  data: { user },
} = supabase ? await supabase.auth.getUser() : { data: { user: null } };
---

<Layout title="Account | iRacional">
  <Navbar />

  <main class="bg-slate-50">
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm">
          <h1 class="text-3xl font-semibold text-slate-900">My account</h1>
          {user ? (
            <>
              <p class="mt-3 text-slate-600">Signed in as <strong>{user.email}</strong>.</p>
              <div class="mt-6 space-y-3">
                <a href="/dashboard" class="block w-full rounded-full border border-slate-300 px-4 py-3 text-center font-medium text-slate-700 transition hover:border-amber-500 hover:text-amber-600">Go to dashboard</a>
                <form method="post" action="/api/auth/signout">
                  <button type="submit" class="w-full rounded-full bg-slate-900 px-4 py-3 font-medium text-white transition hover:bg-amber-600">Sign out</button>
                </form>
              </div>
            </>
          ) : (
            <>
              <p class="mt-3 text-slate-600">Sign in to track your orders, save favorites and manage your profile.</p>
              <div class="mt-6 space-y-3">
                <a href="/login" class="block w-full rounded-full border border-slate-300 px-4 py-3 text-center font-medium text-slate-700 transition hover:border-amber-500 hover:text-amber-600">Open login</a>
                <SignInWithGoogleButton />
              </div>
            </>
          )}
        </div>

        <div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm">
          <h2 class="text-xl font-semibold text-slate-900">Order history</h2>
          <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">No orders yet. Start shopping to create your first history entry.</div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
