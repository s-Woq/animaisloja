---
// src/pages/test-db.astro
import { getSupabaseClient } from '../lib/supabase';

let products = [];
let dbError = null;
let debugInfo = '';

const supabase = getSupabaseClient();

if (!supabase) {
  dbError = 'Supabase client is not configured. Set PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY.';
  debugInfo = 'Missing client configuration';
} else {
  try {
    const { data, error } = await supabase.from('products').select('*');

    if (error) {
      dbError = error.message;
      debugInfo = `Query failed: ${error.message}`;
    } else {
      products = data || [];
      debugInfo = `Loaded ${products.length} row(s)`;
    }
  } catch (err: any) {
    dbError = err.message || 'Failed to connect to Supabase';
    debugInfo = dbError;
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Supabase Connection Test</title>
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 2rem; max-width: 800px; margin: 0 auto;">
    <h1>Supabase Connection Status</h1>

    <p style="margin-bottom: 1rem; color: #475569;"><strong>Debug:</strong> {debugInfo}</p>
    <p style="margin-bottom: 1rem; color: #475569;">Use the Project URL and anon key from your Supabase project dashboard. The URL must start with <code>https://</code>.</p>

    {dbError ? (
      <div style="background: #fee2e2; border: 1px solid #ef4444; color: #991b1b; padding: 1rem; border-radius: 8px;">
        <h2>❌ Connection Failed</h2>
        <p><strong>Error:</strong> {dbError}</p>
        <p>Check that your <code>PUBLIC_SUPABASE_URL</code> and <code>PUBLIC_SUPABASE_ANON_KEY</code> are correctly set in your <code>.env</code> file.</p>
      </div>
    ) : (
      <div style="background: #dcfce7; border: 1px solid #22c55e; color: #166534; padding: 1rem; border-radius: 8px;">
        <h2>✅ Successfully Connected to Supabase!</h2>
        <p>Retrieved <strong>{products.length}</strong> items from the <code>products</code> table.</p>
      </div>
    )}

    {products.length > 0 && (
      <div style="margin-top: 2rem;">
        <h3>Product Data from Database:</h3>
        <ul>
          {products.map((item) => (
            <li>
              <strong>{item.name}</strong> — ${item.price} (Stock: {item.stock})
            </li>
          ))}
        </ul>
      </div>
    )}
  </body>
</html>