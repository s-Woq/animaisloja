---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ProductCard from '../components/ProductCard.astro';
import { categories, featuredProducts, newArrivals } from '../data/products';
---

<Layout title="Paw & Co. | Premium pet essentials">
  <Navbar />

  <main class="bg-slate-50">
    <section class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-8 lg:py-24">
      <div class="flex flex-col justify-center">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-amber-600">Fresh picks for every pet</p>
        <h1 class="text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">Thoughtful products for happy homes.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">From cozy beds to nutrition-rich food and grooming essentials, discover everything your pet needs with a premium shopping experience.</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/shop" class="rounded-full bg-amber-500 px-6 py-3 font-medium text-white transition hover:bg-amber-600">Shop now</a>
          <a href="#categories" class="rounded-full border border-slate-300 px-6 py-3 font-medium text-slate-700 transition hover:border-amber-500 hover:text-amber-600">Explore categories</a>
        </div>
      </div>

      <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white p-4 shadow-xl">
        <img src="https://images.unsplash.com/photo-1517849845537-4d257902454a?auto=format&fit=crop&w=1200&q=80" alt="Happy pets enjoying premium accessories" class="h-[460px] w-full rounded-[1.5rem] object-cover" />
      </div>
    </section>

    <section id="categories" class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="mb-8 flex items-end justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-amber-600">Shop by category</p>
          <h2 class="mt-2 text-3xl font-semibold text-slate-900">Popular pet essentials</h2>
        </div>
      </div>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {categories.slice(0, 8).map((category) => <CategoryCard category={category} />)}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="mb-8 flex items-end justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-amber-600">Best sellers</p>
          <h2 class="mt-2 text-3xl font-semibold text-slate-900">Loved by pet parents</h2>
        </div>
        <a href="/shop" class="text-sm font-semibold text-slate-600 transition hover:text-amber-600">View all</a>
      </div>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {featuredProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="rounded-[2rem] border border-slate-200 bg-slate-900 p-8 text-white shadow-xl lg:p-12">
        <div class="grid gap-8 lg:grid-cols-[1fr_0.7fr] lg:items-center">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-amber-400">New arrivals</p>
            <h2 class="mt-3 text-3xl font-semibold">Fresh finds for a calmer, happier routine.</h2>
            <p class="mt-4 max-w-xl text-lg leading-8 text-slate-300">Upgrade your pet’s daily life with modern accessories, grooming tools and comfort-led favorites.</p>
          </div>
          <div class="rounded-[1.5rem] bg-white/10 p-6 backdrop-blur">
            <h3 class="text-xl font-semibold">Free shipping over $50</h3>
            <p class="mt-3 text-slate-300">Enjoy fast delivery, secure checkout and easy returns on every order.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="mb-8 flex items-end justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-amber-600">Trending now</p>
          <h2 class="mt-2 text-3xl font-semibold text-slate-900">Recently added favourites</h2>
        </div>
      </div>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {newArrivals.map((product) => <ProductCard product={product} />)}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
