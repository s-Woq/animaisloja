---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ProductCard from '../components/ProductCard.astro';
import { categories, featuredProducts, newArrivals } from '../data/products';
---

<Layout title="iRacional | Premium pet essentials">
  <Navbar />

  <main class="bg-transparent">
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
      <div class="relative overflow-hidden rounded-[3rem] border border-orange-500/15 bg-[#050505] px-6 py-8 shadow-[0_40px_120px_rgba(0,0,0,0.45)] sm:px-10 lg:px-12 lg:py-12">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(249,115,22,0.18),transparent_28%),radial-gradient(circle_at_80%_30%,rgba(251,146,60,0.16),transparent_18%),linear-gradient(135deg,rgba(0,0,0,0.2),rgba(0,0,0,0.86))]" />
        <div class="relative grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
          <div class="max-w-2xl">
            <p class="mb-4 text-sm font-semibold uppercase tracking-[0.35em] text-[#fb923c]">Fresh picks for every pet</p>
            <h1 class="max-w-xl text-5xl font-semibold tracking-tight text-[#fff4e8] sm:text-6xl lg:text-7xl">
              <span class="block font-light text-[#d7c5b7]">iRacional</span>
              <span class="block">Thoughtful products</span>
              <span class="block text-[#f97316]">for happy homes.</span>
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-8 text-[#d7c5b7]">From cozy beds to nutrition-rich food and grooming essentials, discover everything your pet needs with a premium shopping experience.</p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="/shop" class="rounded-full bg-[#f97316] px-6 py-3 font-medium text-black transition hover:bg-[#fb923c]">Shop now</a>
              <a href="#categories" class="rounded-full border border-orange-500/20 bg-orange-500/8 px-6 py-3 font-medium text-[#fff4e8] transition hover:border-[#fb923c] hover:text-[#fb923c]">Explore categories</a>
            </div>
            <div class="mt-10 grid max-w-xl grid-cols-3 gap-4 text-sm">
              <div class="rounded-3xl border border-orange-500/15 bg-white/5 p-4 text-[#d7c5b7]">
                <p class="text-xs uppercase tracking-[0.3em] text-[#fb923c]">Premium</p>
                <p class="mt-2 text-lg font-semibold text-[#fff4e8]">Curated mock catalog</p>
              </div>
              <div class="rounded-3xl border border-orange-500/15 bg-white/5 p-4 text-[#d7c5b7]">
                <p class="text-xs uppercase tracking-[0.3em] text-[#fb923c]">Fast</p>
                <p class="mt-2 text-lg font-semibold text-[#fff4e8]">Smooth checkout</p>
              </div>
              <div class="rounded-3xl border border-orange-500/15 bg-white/5 p-4 text-[#d7c5b7]">
                <p class="text-xs uppercase tracking-[0.3em] text-[#fb923c]">Care</p>
                <p class="mt-2 text-lg font-semibold text-[#fff4e8]">Built for pets</p>
              </div>
            </div>
          </div>

          <div class="relative min-h-[520px] lg:min-h-[620px]">
            <div class="absolute inset-y-12 left-6 right-10 rounded-[3rem] border border-orange-500/15 bg-orange-500/8" />
            <div class="absolute left-10 top-12 h-44 w-44 rounded-full border border-orange-500/25 bg-orange-500/10 blur-[2px]" />
            <div class="absolute right-8 top-20 h-36 w-36 rounded-full bg-[#f97316]/25 blur-3xl" />

            <div class="absolute left-4 top-10 w-[calc(100%-6rem)] rounded-[2rem] border border-orange-500/15 bg-black/70 p-3 shadow-[0_30px_80px_rgba(0,0,0,0.45)] backdrop-blur">
              <img src={featuredProducts[0].image} alt={featuredProducts[0].name} class="h-[360px] w-full rounded-[1.5rem] object-cover" />
            </div>

            <div class="absolute right-4 top-24 w-56 rounded-[2rem] border border-orange-500/15 bg-[#0f0f0f] p-3 shadow-[0_20px_60px_rgba(0,0,0,0.45)] backdrop-blur">
              <img src={featuredProducts[2].image} alt={featuredProducts[2].name} class="h-56 w-full rounded-[1.25rem] object-cover" />
            </div>

            <div class="absolute bottom-10 left-12 rounded-full border border-orange-500/20 bg-[#f97316] px-5 py-4 text-sm font-semibold uppercase tracking-[0.25em] text-black shadow-[0_20px_50px_rgba(249,115,22,0.3)]">
              100% Care
            </div>

            <div class="absolute bottom-10 right-10 rounded-[1.5rem] border border-orange-500/15 bg-black/75 p-4 text-[#d7c5b7] shadow-[0_20px_50px_rgba(0,0,0,0.45)]">
              <p class="text-xs uppercase tracking-[0.3em] text-[#fb923c]">Featured</p>
              <p class="mt-2 max-w-[220px] text-sm leading-6">From the smallest to the biggest pets, we have something for everyone.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="categories" class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="mb-8 flex items-end justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#fb923c]">Shop by category</p>
          <h2 class="mt-2 text-3xl font-semibold text-[#fff4e8]">Popular pet essentials</h2>
        </div>
      </div>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {categories.slice(0, 8).map((category) => <CategoryCard category={category} />)}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="mb-8 flex items-end justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#fb923c]">Best sellers</p>
          <h2 class="mt-2 text-3xl font-semibold text-[#fff4e8]">Loved by pet parents</h2>
        </div>
        <a href="/shop" class="text-sm font-semibold text-[#d7c5b7] transition hover:text-[#fb923c]">View all</a>
      </div>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {featuredProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="rounded-[2rem] border border-orange-500/15 bg-[#0a0a0a] p-8 text-white shadow-[0_30px_90px_rgba(0,0,0,0.45)] lg:p-12">
        <div class="grid gap-8 lg:grid-cols-[1fr_0.7fr] lg:items-center">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#fb923c]">New arrivals</p>
            <h2 class="mt-3 text-3xl font-semibold text-[#fff4e8]">Fresh finds for a calmer, happier routine.</h2>
            <p class="mt-4 max-w-xl text-lg leading-8 text-[#d7c5b7]">Upgrade your pet’s daily life with modern accessories, grooming tools and comfort-led favorites.</p>
          </div>
          <div class="rounded-[1.5rem] border border-orange-500/15 bg-white/5 p-6 backdrop-blur">
            <h3 class="text-xl font-semibold text-[#fff4e8]">Free shipping over $50</h3>
            <p class="mt-3 text-[#d7c5b7]">Enjoy fast delivery, secure checkout and easy returns on every order.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="mb-8 flex items-end justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#fb923c]">Trending now</p>
          <h2 class="mt-2 text-3xl font-semibold text-[#fff4e8]">Recently added favourites</h2>
        </div>
      </div>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {newArrivals.map((product) => <ProductCard product={product} />)}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
