---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SignInWithGoogleButton from '../components/SignInWithGoogleButton.astro';
import { getSupabaseServerClient } from '../lib/supabase';

export const prerender = false;

const supabase = getSupabaseServerClient(Astro);
const {
  data: { user },
} = supabase ? await supabase.auth.getUser() : { data: { user: null } };

if (user) {
  return Astro.redirect('/dashboard');
}
---

<Layout title="Login | Lojaa">
  <Navbar />

  <main class="bg-slate-50">
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-lg rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm">
        <h1 class="text-3xl font-semibold text-slate-900">Login</h1>
        <p class="mt-3 text-slate-600">Use your Google account to sign in securely.</p>

        <div class="mt-8">
          <SignInWithGoogleButton />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
