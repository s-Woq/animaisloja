---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact | iRacional">
  <Navbar />

  <main class="bg-slate-50">
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-amber-600">Contact us</p>
          <h1 class="mt-3 text-4xl font-semibold text-slate-900">We’re here to help your pet journey.</h1>
          <p class="mt-4 text-lg leading-8 text-slate-600">Need help with an order, product advice, or a custom recommendation? Fill out the form and our team will get back to you soon.</p>

          <div class="mt-8 space-y-5 text-sm text-slate-600">
            <div>
              <h2 class="font-semibold text-slate-900">Email</h2>
              <p class="mt-1">hello@pawandco.com</p>
            </div>
            <div>
              <h2 class="font-semibold text-slate-900">Phone</h2>
              <p class="mt-1">+1 (800) 555-0142</p>
            </div>
            <div>
              <h2 class="font-semibold text-slate-900">Store hours</h2>
              <p class="mt-1">Mon – Sat • 8:00 AM – 8:00 PM</p>
            </div>
            <div>
              <h2 class="font-semibold text-slate-900">Address</h2>
              <p class="mt-1">42 Ocean Avenue, Seattle, WA 98101</p>
            </div>
          </div>
        </div>

        <div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
          <form class="space-y-5">
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="text-sm font-semibold text-slate-700">Name</label>
                <input id="name" name="name" placeholder="Your name" class="mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-amber-500" />
              </div>
              <div>
                <label for="email" class="text-sm font-semibold text-slate-700">Email</label>
                <input id="email" name="email" type="email" placeholder="you@example.com" class="mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-amber-500" />
              </div>
            </div>

            <div>
              <label for="subject" class="text-sm font-semibold text-slate-700">Subject</label>
              <input id="subject" name="subject" placeholder="How can we help?" class="mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-amber-500" />
            </div>

            <div>
              <label for="message" class="text-sm font-semibold text-slate-700">Message</label>
              <textarea id="message" name="message" rows="6" placeholder="Tell us a bit more about your question or request..." class="mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-amber-500"></textarea>
            </div>

            <button type="button" class="rounded-full bg-amber-500 px-6 py-3 text-sm font-semibold text-white transition hover:bg-amber-600">Send message</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
